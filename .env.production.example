# MyanKafe Finance production environment template.
# Copy to .env.production on the server, fill secrets there, and chmod 600.
# Never commit the filled file.

APP_ENV=production
PUBLIC_ORIGIN=https://finance.example.com
CORS_ORIGIN=https://finance.example.com

# Loopback-only container bindings. Caddy/nginx is the public entry point.
API_PORT=8180
WEB_PORT=3100
# Browser calls the API hostname directly. CORS_ORIGIN stays the frontend origin above.
NEXT_PUBLIC_API_URL=https://finance-api.example.com/api/v1

# Managed/external PostgreSQL is recommended for production.
DATABASE_URL=postgres://finance_app:REPLACE_ME@db.example.internal:5432/myankafe_finance?sslmode=require&pool_max_conns=2
# Goose cannot accept pgx pool parameters. Same database, without pool_max_conns.
GOOSE_DATABASE_URL=postgres://finance_app:REPLACE_ME@db.example.internal:5432/myankafe_finance?sslmode=require

AUTH_MODE=password
AUTH_COOKIE_NAME=myankafe_finance_session
AUTH_SESSION_HOURS=168
AUTH_COOKIE_SECURE=true

# First bootstrap only. Remove BOOTSTRAP_PASSWORD from the server environment after use.
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_DISPLAY_NAME=Owner
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ENTITIES=true

# Private Cloudflare R2 storage.
R2_ENDPOINT=https://dbc116a454dda65b1ab21ad7744e9473.r2.cloudflarestorage.com/myankafe-finance
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_MB=20

# Required if Prometheus/monitoring will scrape /metrics.
METRICS_BEARER_TOKEN=

# Caddy template variables.
FINANCE_HOST=finance.example.com
FINANCE_API_UPSTREAM=127.0.0.1:8180
FINANCE_WEB_UPSTREAM=127.0.0.1:3100
FINANCE_MAX_BODY=25MB
