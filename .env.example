POSTGRES_DB=myankafe_finance
POSTGRES_USER=myankafe
POSTGRES_PASSWORD=myankafe_dev
POSTGRES_PORT=5432

API_PORT=8080
WEB_PORT=3000
APP_ENV=development
CORS_ORIGIN=http://localhost:3000

# Local development may use dev ULID auth. Set AUTH_MODE=password to exercise real sessions.
AUTH_MODE=dev
AUTH_COOKIE_NAME=myankafe_finance_session
AUTH_SESSION_HOURS=168
AUTH_COOKIE_SECURE=false

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEV_USER_ULID=

# Required by bootstrap when AUTH_MODE=password. Do not reuse this example value in production.
BOOTSTRAP_PASSWORD=

# Optional receipt/object storage configuration.
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_MB=20
