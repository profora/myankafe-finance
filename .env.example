POSTGRES_DB=myankafe_finance
POSTGRES_USER=myankafe
POSTGRES_PASSWORD=myankafe_dev
POSTGRES_PORT=5432

API_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

APP_ENV=development
AUTH_MODE=password
AUTH_COOKIE_NAME=myankafe_finance_session
AUTH_SESSION_HOURS=168
AUTH_COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000

# Required for the first owner bootstrap if no credential exists yet.
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_DISPLAY_NAME=Owner
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ENTITIES=true

# Cloudflare R2 (private bucket, S3-compatible API)
# Endpoint example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_MB=20
