POSTGRES_DB=myankafe_finance
POSTGRES_USER=myankafe
POSTGRES_PASSWORD=myankafe_dev
POSTGRES_PORT=5432

API_PORT=8080
WEB_PORT=3000
APP_ENV=development
CORS_ORIGIN=http://localhost:3000

# Username/password sessions.
AUTH_MODE=password
AUTH_COOKIE_NAME=myankafe_finance_session
AUTH_SESSION_HOURS=168
AUTH_COOKIE_SECURE=false

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Required the first time the owner credential is bootstrapped.
# Minimum 12 characters.
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_DISPLAY_NAME=Owner
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# Cloudflare R2 private attachment storage.
# Example endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ATTACHMENT_MAX_MB=20
